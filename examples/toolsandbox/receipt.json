  "tool_catalog": [
    {
      "name": "search_contacts",
      "description": "Search for a contact person based on provided arguments\n\nEach field has a search criteria of either\n1. Exact value matching\n2. Fuzzy string matching with a predefined threshold\nSearch results contains all contact entries that matched all criteria\n\nArgs:\n    person_id:      String format unique identifier for the contact person, will be exact matched\n    name:           Name of contact person, will be fuzzy matched\n    phone_number:   Phone number of contact person, will be exact matched\n    relationship:   Relationship between user and this contact, will be fuzzy matched\n    is_self:        If the requested contact corresponds to the current user. Will be exact matched\n\nReturns:\n    A List of matching contacts. An empty List if no matching contacts were found\n\nRaises:\n    ValueError: When all arguments were not provided",
      "signature": "(person_id: Union[str, tool_sandbox.common.utils.NotGiven] = NOT_GIVEN, name: Union[str, tool_sandbox.common.utils.NotGiven] = NOT_GIVEN, phone_number: Union[str, tool_sandbox.common.utils.NotGiven] = NOT_GIVEN, relationship: Union[str, tool_sandbox.common.utils.NotGiven] = NOT_GIVEN, is_self: Union[bool, tool_sandbox.common.utils.NotGiven] = NOT_GIVEN) -> List[Dict[Literal['person_id', 'name', 'phone_number', 'relationship', 'is_self'], str]]",
      "parameters": [
        {
          "name": "person_id",
          "annotation": "typing.Union[str, tool_sandbox.common.utils.NotGiven]",
          "required": false
        },
        {
          "name": "name",
          "annotation": "typing.Union[str, tool_sandbox.common.utils.NotGiven]",
          "required": false
        },
        {
          "name": "phone_number",
          "annotation": "typing.Union[str, tool_sandbox.common.utils.NotGiven]",
          "required": false
        },
        {
          "name": "relationship",
          "annotation": "typing.Union[str, tool_sandbox.common.utils.NotGiven]",
          "required": false
        },
        {
          "name": "is_self",
          "annotation": "typing.Union[bool, tool_sandbox.common.utils.NotGiven]",
          "required": false
        }
      ],
      "source_file": "tool_sandbox/tools/contact.py"
    },
    {
      "name": "send_message_with_phone_number",
      "description": "Send a message to a recipient using phone_number\n\nArgs:\n    phone_number:   String format phone number to send the message to\n    content:        Message payload text\n\nReturns:\n    String format unique identifier for the message, this can be passed to other functions\n    which require a unique identifier for this message\n\nRaises:\n    ValueError:         If less than or more than 1 self entry was found\n    ConnectionError:    If cellular service is not on",
      "signature": "(phone_number: str, content: str) -> str",
      "parameters": [
        {
          "name": "phone_number",
          "annotation": "<class 'str'>",
          "required": true
        },
        {
          "name": "content",
          "annotation": "<class 'str'>",
          "required": true
        }
      ],
      "source_file": "tool_sandbox/tools/messaging.py"
    },
    {
      "name": "set_cellular_service_status",
      "description": "Enable / Disable cellular service\n\nArgs:\n    on: If we want to turn on cellular service\n\nReturns:\n\nRaises:\n    ValueError:         If cellular service is already turned on / off\n    PermissionError:    If low battery mode is on, in which case we are not allowed to turn on cellular service",
      "signature": "(on: bool) -> None",
      "parameters": [
        {
          "name": "on",
          "annotation": "<class 'bool'>",
          "required": true
        }
      ],
      "source_file": "tool_sandbox/tools/setting.py"
    },
